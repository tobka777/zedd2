{
  "name": "zedd-app",
  "productName": "zedd-app",
  "version": "3.1.0",
  "description": "Zedd-App Time Tracker",
  "main": ".webpack/main",
  "repository": "github:tobka777/zedd2",
  "scripts": {
    "start": "cross-env NODE_INSTALLER=npm electron-forge start -- --dev",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "genicons": "rimraf icons && ts-node -P genIcons.tsconfig.json genIcons.tsx",
    "prettier": "prettier --write 'src/**/*.{ts,tsx,js,d.ts,json}'",
    "test": "cross-env NODE_OPTIONS=--no-experimental-strip-types TS_NODE_TRANSPILE_ONLY=1 TS_NODE_COMPILER_OPTIONS={\\\"module\\\":\\\"commonjs\\\",\\\"rootDir\\\":\\\"./src\\\"} mocha --require ts-node/register src/**/Undoer.test.ts",
    "test:watch": "npm t -- --extension ts,tsx --watch",
    "lint": "eslint src --fix",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": {
    "name": "Andrej Bespalov",
    "email": "andrej.bespalov@capgemini.com"
  },
  "license": "UNLICENSED",
  "prettier": {
    "trailingComma": "all",
    "semi": false,
    "singleQuote": true,
    "jsxSingleQuote": true,
    "printWidth": 100
  },
  "config": {
    "forge": {
      "packagerConfig": {
        "ignore": [
          "^/src($|/)",
          "\\.gitignore",
          "node_modules/\\.cache",
          ".*\\.(iobj|pdb|ipdb)$"
        ],
        "derefSymlinks": true,
        "icon": "icons/app"
      },
      "makers": [
        {
          "name": "@electron-forge/maker-squirrel",
          "config": {
            "name": "zedd",
            "remoteReleases": "https://github.com/tobka777/zedd2/releases/latest/download"
          }
        },
        {
          "name": "@electron-forge/maker-zip",
          "platforms": [
            "darwin"
          ]
        }
      ],
      "plugins": [
        {
          "name": "@electron-forge/plugin-webpack",
          "config": {
            "mainConfig": "./webpack.main.config.js",
            "devContentSecurityPolicy": "connect-src 'self' * 'unsafe-inline' blob: data: gap:",
            "renderer": {
              "config": "./webpack.renderer.config.js",
              "entryPoints": [
                {
                  "html": "./src/index.html",
                  "js": "./src/renderer.ts",
                  "name": "main_window"
                }
              ]
            },
            "loggerPort": "4200"
          }
        }
      ],
      "publishers": [
        {
          "name": "@electron-forge/publisher-github",
          "config": {
            "repository": {
              "owner": "tobka777",
              "name": "zedd2"
            },
            "prerelease": false
          }
        }
      ]
    }
  },
  "dependencies": {
    "puppeteer": "^25.3.0",
    "selenium-webdriver": "^4.46.0",
    "win-ca": "^3.5.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-webpack": "^7.11.2",
    "@electron-forge/publisher-github": "^7.11.2",
    "@electron/remote": "^2.1.3",
    "@eslint/js": "^9.39.5",
    "@emotion/css": "^11.13.5",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fiahfy/icns-convert": "^0.0.12",
    "@fiahfy/ico-convert": "^0.0.12",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "@types/lodash": "^4.17.24",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.1.1",
    "@types/node-windows": "^0.1.6",
    "@types/react": "^19.2.17",
    "@types/react-date-range": "^1.4.10",
    "@types/react-dom": "^19.2.3",
    "@types/selenium-webdriver": "^4.35.6",
    "@types/sinon": "^22.0.0",
    "@types/unzipper": "^0.10.11",
    "@types/webpack-env": "^1.18.8",
    "@types/webpack-node-externals": "^3.0.4",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vercel/webpack-asset-relocator-loader": "1.10.0",
    "async-which": "^1.0.3",
    "chroma.ts": "^1.0.10",
    "convert-svg-to-png": "^0.7.1",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.4",
    "date-fns": "^4.4.0",
    "electron": "^43.2.0",
    "electron-squirrel-startup": "^1.0.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-csv": "^5.0.7",
    "globals": "^16.5.0",
    "jira.js": "^5.4.0",
    "lodash": "^4.18.1",
    "mobx": "^6.16.1",
    "mobx-react-lite": "^4.1.1",
    "mobx-utils": "^6.1.1",
    "mocha": "^11.7.6",
    "natural-orderby": "^5.0.0",
    "node-loader": "^2.1.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "raw-loader": "^4.0.2",
    "react": "^19.2.8",
    "react-date-range": "^2.0.1",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "serializr": "^3.0.5",
    "sharp": "^0.35.3",
    "sinon": "^22.1.0",
    "sleep-promise": "^9.1.0",
    "style-loader": "^4.0.0",
    "sudo-prompt": "^9.2.1",
    "tmp-promise": "^3.0.3",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "unzipper": "^0.12.5",
    "zedd-platform": "file:../zedd-platform"
  }
}
